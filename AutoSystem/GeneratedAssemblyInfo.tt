<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
<#@ template language="C#" hostspecific="true" #>
<#@ output extension=".cs" #>
<#@ import namespace="System" #>

// 这个模板生成：GeneratedAssemblyInfo.cs
// 版本映射规则（四段数字满足 AssemblyFileVersion 要求）:
//   Major = yyyy
//   Minor = MMDD (两位月 + 两位日 => 例如 06月23日 -> 0623)
//   Build = HHmm (小时两位 + 分钟两位 => 15:45 -> 1545)
//   Revision = ss (秒 两位)
<#
    DateTime now = DateTime.Now;
    int major = now.Year;
    int minor = now.Month * 100 + now.Day;       // 0623 -> 623 (数字形式) ，仍合法
    int build = now.Hour * 100 + now.Minute;     // 1545
    int revision = now.Second;                   // 07
    //string fileVersion = string.Format("{0}.{1}.{2}.{3}", major, minor.ToString("D4").TrimStart('0'), build.ToString("D4").TrimStart('0'), revision.ToString("D2"));
	string fileVersion = string.Format("{0}.{1}.{2}.{3}", major, minor.ToString("D4"), build.ToString("D4"), revision.ToString("D2"));
    // 注意：AssemblyFileVersion 必须为 4 段数字，这里确保满足；若你希望保留前导 0，请改为不 TrimStart。
    //string infoVersion = now.ToString("yyyy-MM-dd HH:mm:ss");
    string infoVersion = now.ToString("yy-MM-dd HH:mm");
#>
// <auto-generated />
using System.Reflection;

[assembly: AssemblyFileVersion("<#= fileVersion #>")]
[assembly: AssemblyInformationalVersion("<#= infoVersion #>")]
// 下面两个属性会覆盖 AssemblyInfo.cs 中对应的值，
// 因此请在 AssemblyInfo.cs 中注释掉重复定义的 AssemblyProduct / AssemblyCopyright
[assembly: AssemblyProduct("AutoSystem (build: <#= infoVersion #>)")]
[assembly: AssemblyCopyright("Copyright © <#= now.Year #>")]